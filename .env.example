# Select exactly one provider. The active defaults below use local Ollama.
# To use DeepSeek, replace the four active provider/model/endpoint/method lines
# with the complete commented alternatives below; never create duplicate active keys.
INDUSTRIAL_AGENT_PROVIDER=ollama
INDUSTRIAL_AGENT_MODEL=qwen2.5:7b
INDUSTRIAL_AGENT_OLLAMA_BASE_URL=http://127.0.0.1:11434
# INDUSTRIAL_AGENT_PROVIDER=deepseek
# INDUSTRIAL_AGENT_MODEL=deepseek-v4-flash
# INDUSTRIAL_AGENT_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# INDUSTRIAL_AGENT_STRUCTURED_OUTPUT_METHOD=function_calling
# v4 thinking mode rejects forced tool_choice (breaks structured output);
# the client disables it by default via this flag (set false to re-enable).
# INDUSTRIAL_AGENT_DEEPSEEK_THINKING_DISABLED=true
INDUSTRIAL_AGENT_TEMPERATURE=0
INDUSTRIAL_AGENT_TIMEOUT_SECONDS=30
INDUSTRIAL_AGENT_DEEPSEEK_MAX_RETRIES=2
INDUSTRIAL_AGENT_STRUCTURED_OUTPUT_METHOD=json_schema
# Evidence collection only; report formatting makes one separate fixed model call.
INDUSTRIAL_AGENT_MODEL_RUN_LIMIT=8
INDUSTRIAL_AGENT_TOOL_RUN_LIMIT=8
INDUSTRIAL_AGENT_PER_TOOL_RUN_LIMIT=2

# Observability code owns exporting. These values are only centralized settings
# for this milestone and do not enable or send Trace data on their own.
INDUSTRIAL_AGENT_TRACING_ENABLED=false
INDUSTRIAL_AGENT_TRACING_PROJECT=industrial-diagnostic-agent-dev
INDUSTRIAL_AGENT_ENVIRONMENT=development
INDUSTRIAL_AGENT_TRACING_ENDPOINT=https://api.smith.langchain.com
# Leave empty unless an explicitly enabled observability integration needs it.
INDUSTRIAL_AGENT_LANGSMITH_API_KEY=
# Keep this local only. Do not commit a populated .env file.
INDUSTRIAL_AGENT_DEEPSEEK_API_KEY=

# HTTP API (phase six). The service refuses to start when the key is blank.
INDUSTRIAL_AGENT_API_KEY=
INDUSTRIAL_AGENT_API_RATE_LIMIT=30
